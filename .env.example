# Copiar a .env.local y completar. Ver README.md sección 2 para cómo
# obtener cada valor — este archivo es solo la plantilla, sin secretos
# reales, así que sí se comitea al repo (a diferencia de .env.local).

# --- GitHub (guardado desde /admin) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# --- Vercel Blob (dónde viven las fotos subidas desde el panel) ---
# La crea Vercel sola al conectar un Blob store al proyecto (Storage ->
# el store -> Connect Project), así que normalmente no hay que cargarla
# a mano: aparece ya en las variables del proyecto. Localmente se baja
# con `vercel env pull`.
#
# Sin esta variable el panel no puede subir imágenes, y next.config.ts
# avisa en el build que no va a poder optimizar las fotos servidas desde
# Blob (el hostname permitido se deriva de este token — ver el comentario
# en next.config.ts).
#
# Cada proyecto de Vercel tiene su propio store y su propio token: NO se
# comparte el mismo valor entre el proyecto personal y el de la tienda.
BLOB_READ_WRITE_TOKEN=

# --- Marca del sitio (opcional) ---
# Título grande de la portada del índice ("/") y de la pestaña del
# navegador. Sin esta variable dice "Catálogos" a secas; cada despliegue
# que quiera su propio nombre la define acá (ej. "Catálogos Mawoa").
# Se lee en build time (página estática), así que hay que redesplegar
# para que un cambio se vea.
SITE_TITLE=

# --- Login del admin ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# --- Google Drive (opcional — solo para "Importar desde Google Drive") ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
