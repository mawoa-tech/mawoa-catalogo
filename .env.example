# Copiar a .env.local y completar. Ver README.md sección 2 para cómo
# obtener cada valor — este archivo es solo la plantilla, sin secretos
# reales, así que sí se comitea al repo (a diferencia de .env.local).

# --- GitHub (guardado desde /admin) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# --- Vercel Blob (dónde viven las fotos subidas desde el panel) ---
# La crea Vercel sola al conectar un Blob store al proyecto (Storage ->
# el store -> Connect Project), así que normalmente no hay que cargarla
# a mano: aparece ya en las variables del proyecto. Localmente se baja
# con `vercel env pull`.
#
# Sin esta variable el panel no puede subir imágenes, y next.config.ts
# avisa en el build que no va a poder optimizar las fotos servidas desde
# Blob (el hostname permitido se deriva de este token — ver el comentario
# en next.config.ts).
#
# Cada proyecto de Vercel tiene su propio store y su propio token: NO se
# comparte el mismo valor entre el proyecto personal y el de la tienda.
BLOB_READ_WRITE_TOKEN=

# --- Marca del sitio (opcional) ---
# Título grande de la portada del índice ("/") y de la pestaña del
# navegador. Sin esta variable dice "Catálogos" a secas; cada despliegue
# que quiera su propio nombre la define acá (ej. "Catálogos Mawoa").
# Se lee en build time (página estática), así que hay que redesplegar
# para que un cambio se vea.
SITE_TITLE=

# --- Login del admin ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# --- Inventario: dónde vive el stock (opcional) ---
# Token de un store de Vercel Blob PRIVADO, distinto del de las fotos
# (BLOB_READ_WRITE_TOKEN): el acceso es una propiedad del store entero, y
# el de fotos tiene que ser público para poder servirlas. Ver README 2.5.
INVENTARIO_READ_WRITE_TOKEN=

# --- Inventario en Google Sheets (opcional) ---
# Cuenta de servicio de Google que lee y escribe la hoja de inventario.
# SIN NEXT_PUBLIC_ a propósito: con ese prefijo la clave privada viajaría
# dentro del JavaScript que descarga cualquier visitante. Ver README 2.4
# para el paso a paso de cómo obtenerlas.
#
# GOOGLE_PRIVATE_KEY llega en dos formas distintas según de dónde salga, y
# el código que la use TIENE que normalizarla con .replace(/\\n/g, "\n"):
# acá (.env.local) los \n los expande el loader de Next y process.env queda
# con saltos de línea reales, pero Vercel guarda el valor literal, así que
# en producción llegan como la secuencia \n de dos caracteres. El replace es
# inofensivo cuando ya son saltos reales, y sin él la clave no parsea.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Google Drive (opcional — solo para "Importar desde Google Drive") ---
# Alcanza con el Client ID: desde que el explorador de Drive es propio
# del panel (y no el Picker de Google, que vivía en un iframe sin estilo
# posible), la API Key y el número de proyecto dejaron de usarse — si
# venís de una versión anterior, se pueden borrar.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
